# ╔═══════════════════════════════════════════════════════════╗
# ║  ESP32-S3 AI Assistant — Server Configuration            ║
# ╚═══════════════════════════════════════════════════════════╝
#
# Copy this file:  cp .env.example .env
# Then edit the values below.

# === General ===
TZ=Asia/Ho_Chi_Minh
# Your server's LAN or public IP (used in config templates)
SERVER_IP=192.168.1.100

# === Xiaozhi Server Ports ===
XIAOZHI_WS_PORT=8000       # WebSocket (ESP32 devices)
XIAOZHI_WEB_PORT=8002      # 智控台 Web Panel
XIAOZHI_HTTP_PORT=8003     # HTTP/OTA endpoint

# === Database (MySQL) ===
MYSQL_ROOT_PASSWORD=xiaozhi2025

# === Redis ===
REDIS_PASSWORD=

# === OpenClaw Gateway ===
OPENCLAW_PORT=18789
OPENCLAW_PASSWORD=changeme

# === OpenClaw AI Provider (set at least one) ===
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
