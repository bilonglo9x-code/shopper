{
  "manifest_version": 3,
  "name": "Shopper - Shopee Data Collector",
  "version": "1.0.0",
  "description": "Thu thập dữ liệu sản phẩm từ Shopee: thông tin, giá, reviews, hình ảnh, video",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://shopee.vn/*",
    "https://shopee.sg/*",
    "https://shopee.co.id/*",
    "https://shopee.co.th/*",
    "https://shopee.com.my/*",
    "https://shopee.tw/*",
    "https://shopee.ph/*",
    "https://shopee.com.br/*",
    "https://shopee.com.mx/*",
    "https://shopee.com.co/*",
    "https://shopee.cl/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://shopee.vn/*",
        "https://shopee.sg/*",
        "https://shopee.co.id/*",
        "https://shopee.co.th/*",
        "https://shopee.com.my/*",
        "https://shopee.tw/*",
        "https://shopee.ph/*",
        "https://shopee.com.br/*",
        "https://shopee.com.mx/*",
        "https://shopee.com.co/*",
        "https://shopee.cl/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/shopee-api.js"],
      "matches": [
        "https://shopee.vn/*",
        "https://shopee.sg/*",
        "https://shopee.co.id/*",
        "https://shopee.co.th/*",
        "https://shopee.com.my/*",
        "https://shopee.tw/*",
        "https://shopee.ph/*",
        "https://shopee.com.br/*",
        "https://shopee.com.mx/*",
        "https://shopee.com.co/*",
        "https://shopee.cl/*"
      ]
    }
  ]
}
